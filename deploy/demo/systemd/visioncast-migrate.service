# One-shot: apply database migrations. Started explicitly by deploy/demo/deploy.sh
# (`systemctl start` waits for it to finish); never enabled, never runs at boot.
[Unit]
Description=VisionCast demo database migrations (one-shot)
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=visioncast
Group=visioncast
WorkingDirectory=/srv/visioncast/app
EnvironmentFile=/etc/visioncast/visioncast.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ExecStart=/srv/visioncast/venv/bin/python /srv/visioncast/app/manage.py migrate --noinput
TimeoutStartSec=600

# Writable paths: none.
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=512M
