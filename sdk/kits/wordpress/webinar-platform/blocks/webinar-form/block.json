{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "webinar-platform/webinar-form",
  "version": "0.1.0",
  "title": "Webinar registration form",
  "category": "widgets",
  "icon": "calendar-alt",
  "description": "RSVP form for one webinar session. Submits through this site's /webinar-api proxy.",
  "textdomain": "webinar-platform",
  "attributes": {
    "occurrenceId": { "type": "string", "default": "" },
    "formVersion": { "type": "string", "default": "" },
    "fields": {
      "type": "array",
      "items": { "type": "string" },
      "default": ["email", "firstName", "lastName", "company"]
    },
    "required": {
      "type": "array",
      "items": { "type": "string" },
      "default": ["email"]
    },
    "submitLabel": { "type": "string", "default": "" },
    "confirmLabel": { "type": "string", "default": "" }
  },
  "supports": { "html": false },
  "editorScript": "file:./index.js"
}
