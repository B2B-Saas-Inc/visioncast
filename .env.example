# Webinar platform configuration. Copy to .env and fill in every value marked
# REQUIRED. This file intentionally contains NO secrets and NO default passwords;
# the application refuses to start in production mode with missing secrets.
#
# Generate secrets locally (no third-party packages required):
#   Django secret key / DB password:
#     python3 -c "import secrets; print(secrets.token_urlsafe(50))"
#   Fernet master key (32 random bytes, url-safe base64):
#     python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#
# Keep .env out of version control and readable only by the deploying user
# (chmod 600 .env). It is excluded from the Docker build context.

# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------
# REQUIRED. Long random value (see command above).
DJANGO_SECRET_KEY=
# Leave 0 in production. 1 enables debug pages and relaxes fail-closed checks.
DJANGO_DEBUG=0
# REQUIRED. Comma-separated host names served by this instance (no scheme).
DJANGO_ALLOWED_HOSTS=webinars.example.com
# Comma-separated exact origins (scheme://host[:port]) trusted for admin CSRF.
CSRF_TRUSTED_ORIGINS=https://webinars.example.com
# Set to 1 ONLY when a TLS-terminating reverse proxy always overwrites
# X-Forwarded-Proto. Otherwise clients could spoof "https". TLS, rate limiting and
# admin MFA are NOT built in and must be provided at the edge before internet
# exposure; see docker/nginx.conf.example (untested example).
# In production Django redirects plain-HTTP requests to HTTPS (except /healthz), so
# without this flag behind a TLS proxy every request would redirect in a loop.
DJANGO_TRUST_X_FORWARDED_PROTO=0
# Absolute public base URL used in ICS links and webhook payloads.
PUBLIC_BASE_URL=https://webinars.example.com
# Optional marketing-site event page written into calendar entries (ICS URL/description,
# Google/Outlook links). https only; placeholders {slug} and {occurrence_id} after the host.
# Empty (or invalid; `manage.py check` reports webinars.E101) uses the JSON event API URL.
PUBLIC_EVENT_URL_TEMPLATE=

# ---------------------------------------------------------------------------
# PostgreSQL (also consumed by the `db` service in compose.yaml)
# ---------------------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=webinars
POSTGRES_USER=webinars
# REQUIRED. Random value (see command above). The db container will not start without it.
POSTGRES_PASSWORD=
# "prefer" suits the bundled compose database on the internal network.
# Use "verify-full" (with a CA bundle) for any external/managed database.
POSTGRES_SSLMODE=prefer

# ---------------------------------------------------------------------------
# Integration secrets encryption
# ---------------------------------------------------------------------------
# REQUIRED. Fernet key that encrypts destination signing secrets/credentials.
# Store it outside the database backups (e.g. a secrets manager).
INTEGRATION_MASTER_KEY=
# Comma-separated previous Fernet keys, only during a key rotation (see docs/operations.md).
INTEGRATION_MASTER_KEY_PREVIOUS=

# ---------------------------------------------------------------------------
# Browser integration / redirects / webhooks
# ---------------------------------------------------------------------------
# Comma-separated exact origins allowed to call /webinar-api/* (same-origin direct proxy).
WEBINAR_ALLOWED_ORIGINS=https://www.example.com
# Direct mode: registration calendar.icsUrl points at /webinar-api/calendar.ics (default 1).
# Set 0 only if your edge routes /api/v1/occurrences/ and you depend on the old link.
WEBINAR_DIRECT_ICS_REWRITE=1
# Comma-separated host names permitted as thank-you redirect targets (https only).
THANK_YOU_REDIRECT_HOSTS=www.example.com
# Comma-separated host names generic webhook destinations may target (https only; private IPs always
# blocked). Native integrations send only to hosts pinned in code and need no entry here.
WEBHOOK_HOST_ALLOWLIST=
# Set to 0 to require an allowlist entry for native vendor hosts as well (the old double gate).
# NATIVE_VENDOR_HOSTS_IMPLICIT=1

# ---------------------------------------------------------------------------
# Behaviour tuning
# ---------------------------------------------------------------------------
# Browser capability cookie name; must equal the first-party proxy's PROXY_SESSION_COOKIE.
CAPABILITY_COOKIE_NAME=webinar_session
# Browser capability cookie lifetime.
CAPABILITY_TTL_DAYS=180
# Comma-separated reminder offsets (minutes before start).
REMINDER_OFFSETS_MINUTES=1440,60
# Reminders more than this many minutes late are skipped, not sent (settings default: 15).
REMINDER_LATE_GRACE_MINUTES=15
# Outbox claim lease length; an expired lease lets another worker retry. Each webhook
# send is bounded by min(WEBHOOK_TOTAL_TIMEOUT_SECONDS (30), remaining lease - 9s), so keep
# this well above that total plus 10.
OUTBOX_LEASE_SECONDS=120
# Touched by run_worker each loop; checked by docker/worker_healthcheck.py (must be on a writable path).
WORKER_HEARTBEAT_FILE=/tmp/worker-heartbeat
# gunicorn worker processes for the web role.
WEB_CONCURRENCY=3
# Optional (defaults shown):
# WEBHOOK_TIMEOUT_SECONDS=10          # per socket operation; the total per send is capped separately
# WEBHOOK_TOTAL_TIMEOUT_SECONDS=30    # whole send, 5-600; also capped at run time by remaining lease - 9s
# WEBHOOK_ALLOWED_PORTS=443
# OUTBOX_BATCH_SIZE=20
# OUTBOX_PAYLOAD_RETENTION_DAYS=30
# IDEMPOTENCY_TTL_HOURS=72
# DJANGO_LOG_LEVEL=INFO
# Read by docker/worker_healthcheck.py only (seconds since the last heartbeat).
# WORKER_HEARTBEAT_MAX_AGE=60
# Set to 0 only if this is not a browser-facing HTTPS deployment (tests/local).
# CAPABILITY_COOKIE_SECURE=1

# ---------------------------------------------------------------------------
# Edge / HTTPS hardening (optional; production defaults shown)
# ---------------------------------------------------------------------------
# DJANGO_SECURE_SSL_REDIRECT=1        # /healthz is exempt
# DJANGO_SESSION_COOKIE_SECURE=1
# DJANGO_CSRF_COOKIE_SECURE=1
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=0
# DJANGO_HSTS_PRELOAD=0
# DJANGO_STATIC_ROOT=/app/staticfiles

# ---------------------------------------------------------------------------
# Built-in rate limits (per process, per client IP; NOT a substitute for edge limits)
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=1
# 1 ONLY behind a reverse proxy that controls X-Forwarded-For; otherwise clients
# choose their own rate-limit key.
RATE_LIMIT_TRUST_X_FORWARDED_FOR=0
# Number of trusted proxies that each append to X-Forwarded-For (1-10, default 1).
# The client address is the Nth entry from the right. Ignored while the flag above is 0.
# RATE_LIMIT_TRUSTED_PROXY_COUNT=1

# ---------------------------------------------------------------------------
# Outgoing email: waiting-room verification codes and teammate invitations ONLY
# (attendee confirmations/reminders go through webhooks). See docs/email.md.
# ---------------------------------------------------------------------------
# "disabled" drops every message (nothing leaves the process); "smtp" sends.
EMAIL_DELIVERY=disabled
DEFAULT_FROM_EMAIL=webinars@example.com
# Required only when EMAIL_DELIVERY=smtp. Exactly one of STARTTLS / SSL must be 1
# in production. Put the password in your secret store, not in version control.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=1
# SMTP_SSL=0
# SMTP_TIMEOUT_SECONDS=10
# Studio teammate invitation link lifetime.
INVITATION_TTL_HOURS=72

# ---------------------------------------------------------------------------
# Hosted waiting room (/w/<code>/, docs/waiting-room.md)
# ---------------------------------------------------------------------------
WAITING_ROOM_VERIFICATION_TTL_MINUTES=15
WAITING_ROOM_MAX_CODE_ATTEMPTS=5
WAITING_ROOM_MAX_CODES_PER_EMAIL=3
WAITING_ROOM_POLL_SECONDS=15
# Optional platform-wide caps per TTL window (1-50, defaults shown): codes per address
# across all rooms, and guesses per (browser, address) across all rooms.
# WAITING_ROOM_MAX_CODES_PER_EMAIL_GLOBAL=10
# WAITING_ROOM_MAX_GUESSES_PER_EMAIL=10

# ---------------------------------------------------------------------------
# Image selection for compose.yaml (optional; defaults build locally)
# ---------------------------------------------------------------------------
# Image run by migrate/web/worker. `docker compose build` produces webinar-platform:local;
# deploy/build-image.sh tags webinar-platform:<version> (and <version>-<commit>).
# WEBINAR_IMAGE=webinar-platform:local
# Pull policy of the `migrate` service (the only one with a build section). "build" builds
# locally; "never" uses an image you pulled or built already (nothing is built). No image
# has been published to a registry yet (publishing needs the owner's approval).
# WEBINAR_PULL_POLICY=build

# ---------------------------------------------------------------------------
# First-run bootstrap
# ---------------------------------------------------------------------------
# Optional. Leave EMPTY; see `manage.py bootstrap_admin --help`. If you set it
# for a non-interactive bootstrap, use a freshly generated value and delete it
# from .env immediately after the first run.
BOOTSTRAP_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Tests only
# ---------------------------------------------------------------------------
# Set to 1 to run the test suite against SQLite. That is NOT evidence for
# PostgreSQL behaviour (locking, SKIP LOCKED, constraints). Never set in production:
# it also disables every fail-closed check on missing secrets and hosts.
# DJANGO_TEST_SQLITE=1
